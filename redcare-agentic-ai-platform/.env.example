# =====================================================================================
# Copy to .env for local development. .env is gitignored and must stay that way.
#
# You do not need any of this to run the playground: LLM_MODE=mock is the default and
# needs no credentials, no network and costs nothing. Fill these in only when you want
# to route through a real LiteLLM gateway to real models.
# =====================================================================================

# mock | litellm
LLM_MODE=mock

# --- gateway ---------------------------------------------------------------------------
LITELLM_BASE_URL=http://localhost:4000
LITELLM_VIRTUAL_KEY=sk-carecopilot-dev
LITELLM_MASTER_KEY=sk-master-local-only
LITELLM_SALT_KEY=change-me-local-only

# --- providers (in Azure these come from Key Vault, never from a file) -----------------
AZURE_OPENAI_SWEDEN_ENDPOINT=
AZURE_OPENAI_SWEDEN_KEY=
AZURE_OPENAI_WESTEU_ENDPOINT=
AZURE_OPENAI_WESTEU_KEY=
ANTHROPIC_API_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# --- observability ----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# --- behaviour ----------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
PII_REDACTION_ENABLED=true
HITL_ENABLED=true
BUDGET_PER_REQUEST_USD=0.08
BUDGET_TENANT_DAILY_USD=25
